{
  "name": "svelte-starter-kit",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "bun run build && wrangler dev",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "deploy": "bun run build && wrangler deploy",
    "gen": "wrangler types",
    "cf-typegen": "wrangler types"
  },
  "devDependencies": {
    "@lucide/svelte": "^0.577.0",
    "@sveltejs/adapter-cloudflare": "^7.2.8",
    "@sveltejs/kit": "^2.55.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/telegram-web-app": "^9.5.0",
    "bits-ui": "^2.16.3",
    "clsx": "^2.1.1",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.5.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "svelte": "^5.54.0",
    "svelte-check": "^4.4.5",
    "svelte-render-scan": "^1.1.0",
    "svelte-sonner": "^1.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-kit-routes": "^1.0.2",
    "wrangler": "^4.75.0"
  },
  "dependencies": {
    "@instantdb/admin": "^0.22.165",
    "@instantdb/svelte": "^0.22.165",
    "@sveltebase/i18n": "^0.2.2",
    "@sveltebase/instant": "^0.2.2",
    "@sveltebase/state": "^0.2.2",
    "@sveltebase/utils": "^0.2.2",
    "@tanstack/query-async-storage-persister": "^5.90.27",
    "@tanstack/svelte-form": "^1.28.5",
    "@tanstack/svelte-query": "^6.1.3",
    "@tanstack/svelte-query-persist-client": "^6.0.25",
    "date-fns": "^4.1.0",
    "maska": "^3.2.0",
    "mode-watcher": "^1.1.0",
    "runed": "^0.37.1",
    "svelte-dropzone-runes": "^1.0.6",
    "use-intl": "^4.8.3",
    "vaul-svelte": "^1.0.0-next.7",
    "zod": "^4.3.6"
  }
}
